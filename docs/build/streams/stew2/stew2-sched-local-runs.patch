+/**
+ * Guarded local work running outside the queue (STEW-2): scripts/local-guard.mjs
+ * writes <dir>/local-runs/<pid>.json ({ pid, start, at, what, cwd }) for the life
+ * of the process doing the work. A lease counts while that process lives (pid and
+ * start time) and is younger than localRunMaxS; an older one is reported as stale,
+ * so one forgotten long process can't hold the exclusive lane forever.
+ */
+export function localRuns(cfg, now = Date.now()) {
+  const dir = join(cfg.dir, "local-runs"), live = [], stale = [];
+  let names = [];
+  try { names = readdirSync(dir).filter((n) => /^\d+\.json$/.test(n)); } catch { return { live, stale }; }
+  for (const n of names) {
+    const lease = readJson(join(dir, n));
+    if (!lease || !alive(lease)) continue;
+    (now - lease.at < (cfg.localRunMaxS ?? 1200) * 1000 ? live : stale).push(lease);
+  }
+  return { live, stale };
+}
