{
  "name": "siltwake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && node scripts/bake-terrain.mjs && vite build",
    "bake:terrain": "node scripts/bake-terrain.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:build": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test:fast": "npm run typecheck && npm run test:build && node scripts/test-tier.mjs fast",
    "test:heavy": "npm run test:build && scripts/heavy-check.sh --deadline 1200 node scripts/test-tier.mjs heavy",
    "test": "npm run test:fast",
    "check": "npm run test:fast && npm run test:heavy && npm run build",
    "playthrough": "tsc -p scripts/playthrough/tsconfig.json && node .test-build/scripts/playthrough/run.js"
  },
  "dependencies": { "@babylonjs/core": "9.31.0" },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
