{
  "name": "siltwake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && node scripts/bake-terrain.mjs && vite build",
    "bake:terrain": "node scripts/bake-terrain.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:build": "node scripts/test-build.mjs",
    "test:fast": "node scripts/test-build.mjs --typecheck && node scripts/test-tier.mjs fast",
    "test:heavy": "scripts/heavy-check.sh --class heavy-suite -- sh -c 'node scripts/test-build.mjs && node scripts/test-tier.mjs heavy'",
    "test": "npm run test:fast",
    "check": "npm run test:fast && npm run test:heavy && node scripts/bake-terrain.mjs && vite build",
    "gate": "node scripts/gate.mjs",
    "playthrough": "tsc -p scripts/playthrough/tsconfig.json && node .test-build/scripts/playthrough/run.js"
  },
  "dependencies": { "@babylonjs/core": "9.31.0" },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
